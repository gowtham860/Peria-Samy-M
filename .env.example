# ===================================================================
# SkillPath AI - Environment Variables Template
# Copy this file to .env (do not commit .env to source control)
# ===================================================================

# AI Provider API Key (Used by Firebase Functions server-side runtime)
# Set in production with: firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default AI Model override
AI_MODEL_NAME=gemini-2.5-flash

# Firebase Client Configuration (Public variables for frontend SDK)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Local Development Emulator Toggle (true/false)
USE_FIREBASE_EMULATORS=false
